# TTS server URL for the frontend
# Copy this file to .env.local for local development (ignored by git)
# Or rename to .env for production builds
#
# Local development (uses the standalone TTS server):
VITE_TTS_BASE_URL=http://localhost:8001
#
# Production (uses the backend endpoint):
# VITE_TTS_BASE_URL=https://unefa-asistente.duckdns.org
